
require "fileutils"
require "shellwords"
require "open3"
require "spaceship"

default_platform(:ios)

ROOT_DIR = File.expand_path("../..", __dir__)
NOTES_ROOT = File.join(ROOT_DIR, "release-notes")
IPA_PATH = File.join(ROOT_DIR, "build/ios/ipa/AlgoBot.ipa")
APP_IDENTIFIER = "com.fabsora.algobot"
LOCALES = ["tr-TR", "en-US"].freeze

def algobot_version
  pubspec = File.join(ROOT_DIR, "pubspec.yaml")
  UI.user_error!("pubspec.yaml not found") unless File.file?(pubspec)

  line = File.readlines(pubspec).find { |item| item.match?(/^version:\s*/) }
  UI.user_error!("Version not found") unless line

  version = line.split(":", 2).last.strip

  unless version.match?(/\A\d+\.\d+\.\d+\+\d+\z/)
    UI.user_error!("Invalid version: #{version}")
  end

  version
end

def algobot_release_data
  full_version = algobot_version
  marketing_version, build_number = full_version.split("+")
  directory = File.join(NOTES_ROOT, full_version)

  UI.user_error!("Release directory not found: #{directory}") unless Dir.exist?(directory)

  notes = {}
  promotional = {}

  LOCALES.each do |locale|
    notes_path = File.join(directory, "#{locale}.txt")
    promotional_path = File.join(directory, "promotional-#{locale}.txt")

    UI.user_error!("Missing file: #{notes_path}") unless File.file?(notes_path)
    UI.user_error!("Missing file: #{promotional_path}") unless File.file?(promotional_path)

    notes_text = File.read(notes_path, encoding: "UTF-8").strip
    promotional_text = File.read(promotional_path, encoding: "UTF-8").strip

    UI.user_error!("Empty release notes: #{locale}") if notes_text.empty?
    UI.user_error!("Empty promotional text: #{locale}") if promotional_text.empty?

    UI.user_error!("Release notes exceed 4000 characters: #{locale}") if notes_text.length > 4000
    UI.user_error!("Promotional text exceeds 170 characters: #{locale}") if promotional_text.length > 170

    notes[locale] = notes_text
    promotional[locale] = promotional_text
  end

  {
    full_version: full_version,
    marketing_version: marketing_version,
    build_number: build_number,
    notes: notes,
    promotional: promotional
  }
end

def algobot_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

  UI.user_error!("Missing API Key ID") if key_id.to_s.empty?
  UI.user_error!("Missing Issuer ID") if issuer_id.to_s.empty?
  UI.user_error!("Missing API key path") if key_path.to_s.empty?
  UI.user_error!("API key file not found") unless File.file?(key_path)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

# Check whether the exact iOS version and build already exist.
# Fail closed if the App Store Connect API query fails.

def algobot_check_store_version(data)
  UI.header("Checking App Store Connect build version")
  UI.message("Bundle ID: #{APP_IDENTIFIER}")
  UI.message("Version: #{data[:marketing_version]}")
  UI.message("Build: #{data[:build_number]}")

  begin
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)

    UI.user_error!(
      "App not found on App Store Connect: #{APP_IDENTIFIER}"
    ) unless app

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: data[:marketing_version],
      build_number: data[:build_number],
      platform: "IOS"
    )
  rescue => error
    UI.user_error!(
      "App Store Connect API query failed. Upload blocked! #{error.message}"
    )
  end

  if builds.any?
    UI.user_error!(
      "Build #{data[:full_version]} already exists on App Store Connect. Upload blocked!"
    )
  end

  UI.success(
    "Build #{data[:full_version]} not found on App Store Connect."
  )
end

def algobot_prepare_metadata(data)
  metadata_dir = File.join(ROOT_DIR, "build", "fastlane", "ios-metadata")

  FileUtils.rm_rf(metadata_dir)
  FileUtils.mkdir_p(metadata_dir)

  LOCALES.each do |locale|
    locale_dir = File.join(
      metadata_dir,
      locale == "tr-TR" ? "tr" : locale
    )

    FileUtils.mkdir_p(locale_dir)

    File.write(
      File.join(locale_dir, "release_notes.txt"),
      data[:notes][locale]
    )

    File.write(
      File.join(locale_dir, "promotional_text.txt"),
      data[:promotional][locale]
    )
  end

  metadata_dir
end

# Verify version, build number and bundle identifier
# from the actual IPA file before uploading.

def algobot_verify_ipa
  UI.user_error!("IPA file not found: #{IPA_PATH}") unless File.file?(IPA_PATH)

  entries, list_error, list_status = Open3.capture3(
    "unzip", "-Z1", IPA_PATH
  )

  UI.user_error!(
    "Unable to inspect IPA: #{list_error}"
  ) unless list_status.success?

  plist_path = entries.lines.map(&:strip).find do |entry|
    entry.match?(%r{\APayload/[^/]+\.app/Info\.plist\z})
  end

  UI.user_error!("Main app Info.plist not found in IPA") unless plist_path

  plist, unzip_error, unzip_status = Open3.capture3(
    "unzip", "-p", IPA_PATH, plist_path
  )

  UI.user_error!(
    "Unable to read IPA Info.plist: #{unzip_error}"
  ) unless unzip_status.success?

  values = {}

  [
    "CFBundleShortVersionString",
    "CFBundleVersion",
    "CFBundleIdentifier"
  ].each do |key|
    value, error, status = Open3.capture3(
      "plutil",
      "-extract", key,
      "raw",
      "-o", "-",
      "-",
      stdin_data: plist
    )

    UI.user_error!(
      "Unable to read #{key} from IPA: #{error}"
    ) unless status.success?

    values[key] = value.strip
  end

  expected_name, expected_build = algobot_version.split("+")

  expected = {
    "CFBundleShortVersionString" => expected_name,
    "CFBundleVersion" => expected_build,
    "CFBundleIdentifier" => APP_IDENTIFIER
  }

  expected.each do |key, wanted|
    actual = values.fetch(key)

    UI.user_error!(
      "IPA #{key} mismatch: expected #{wanted}, got #{actual}"
    ) unless actual == wanted
  end

  UI.success(
    "iOS IPA version verified: #{expected_name}+#{expected_build}"
  )
end

platform :ios do

  desc "Validate local Apple API key configuration"
  lane :check_auth do
    algobot_api_key
    UI.success("Apple API key loaded successfully!")
  end

  desc "Validate version and localized release metadata"
  lane :check_release do
    data = algobot_release_data

    UI.header("AlgoBot iOS Release Validation")
    UI.message("Version: #{data[:marketing_version]}")
    UI.message("Build: #{data[:build_number]}")

    LOCALES.each do |locale|
      UI.message(
        "#{locale} What's New: #{data[:notes][locale]}"
      )

      UI.message(
        "#{locale} Promotional Text: #{data[:promotional][locale]}"
      )
    end

    UI.success("Release metadata validated!")
  end

  desc "Check whether current build already exists on App Store Connect"
  lane :check_store_version do
    data = algobot_release_data

    algobot_api_key
    algobot_check_store_version(data)
  end

  desc "Build Flutter IPA"
  lane :build do
    Dir.chdir(ROOT_DIR) do
      sh("flutter pub get")
      sh("flutter build ipa --release")
    end

    algobot_verify_ipa

    UI.success("IPA build completed: #{IPA_PATH}")
  end

  desc "Upload existing IPA and localized metadata to App Store Connect"
  lane :upload do
    data = algobot_release_data

    # Verify the IPA before any upload.
    algobot_verify_ipa

    # Authenticate with App Store Connect.
    api_key = algobot_api_key

    # Block duplicate builds before preparing metadata
    # or asking for upload confirmation.
    algobot_check_store_version(data)

    metadata_dir = algobot_prepare_metadata(data)

    UI.header("AlgoBot App Store Connect Upload")
    UI.message("Version: #{data[:full_version]}")
    UI.message("IPA: #{IPA_PATH}")
    UI.message("Languages: #{LOCALES.join(', ')}")

    unless UI.confirm("Upload IPA and metadata to App Store Connect?")
      UI.message("Upload cancelled.")
      next
    end

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: IPA_PATH,
      app_version: data[:marketing_version],
      metadata_path: metadata_dir,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )

    UI.success("Upload operation completed!")
    UI.message("App Review submission is a separate step.")
  end

  desc "Build and upload AlgoBot to App Store Connect"
  lane :release do
    check_release
    build
    upload
  end

  desc "Retry upload using existing IPA"
  lane :retry_release do
    upload
  end

  desc "Verify existing IPA version and bundle identifier"
  lane :verify_ipa do
    algobot_verify_ipa
    UI.success("iOS IPA verification completed!")
  end

end

